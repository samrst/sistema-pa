generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Use MariaDB/MySQL provider for Prisma. Set DATABASE_URL in backend .env
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AcoesSaep {
  id                        String   @id @db.Char(36) @default(uuid())
  created_at                DateTime @default(now()) @db.DateTime(6)
  updated_at                DateTime @updatedAt @db.DateTime(6)

  unidade                   String   @db.Text
  curso                     String   @db.Text
  modalidade                String   @db.Text
  capacidade_saep           String   @db.Text

  problema_identificado     String   @db.Text
  evidencias                String?  @db.Text
  classificacao_criticidade String?  @default("Adequado") @db.Text

  meta_objetiva             String?  @db.Text
  meta_pratica              String?  @db.Text
  meta_prazo                DateTime? @db.Date

  acao                      String   @db.Text
  tipo_acao                 String   @db.Text
  entregavel                String?  @db.Text

  responsavel_principal     String   @db.Text
  funcao_cargo              String?  @db.Text
  co_responsaveis           String?  @db.Text
  apoios_necessarios        Json?

  data_inicio               DateTime? @db.Date
  data_fim                  DateTime? @db.Date

  status                    String   @default("Não iniciado") @db.Text
  risco                     String?  @default("Baixo") @db.Text
  plano_mitigacao           String?  @db.Text
  custo_estimado            Decimal? @db.Decimal(12,2)
  prioridade                String?  @default("Média") @db.Text
  impacto_saep              String?  @default("Médio") @db.Text
  observacoes               String?  @db.Text

  @@map("acoes_saep")
}
